{
  "name": "story-video-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Kịch bản + giọng đọc + ảnh AI → video kể chuyện (Remotion): Ken Burns, phụ đề karaoke, SFX, nhạc nền, chuẩn loudness -14 LUFS",
  "scripts": {
    "scenes": "tsx scripts/parse-scenes.ts",
    "sfx": "python3 scripts/gen-sfx.py",
    "remove-bg": "python3 scripts/remove-bg.py",
    "timeline": "tsx scripts/build-timeline.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Story out/raw.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "finalize": "tsx scripts/finalize.ts out/raw.mp4 out/final.mp4",
    "build": "npm run timeline && npm run render && npm run finalize",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/effects": "^4.0.533",
    "@remotion/google-fonts": "^4.0.533",
    "@remotion/rough-notation": "^4.0.533",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
